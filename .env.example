# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/strata_vault

# Generate a long random value; never commit the real secret.
SESSION_SECRET=replace-with-a-long-random-secret

# Anthropic-compatible endpoint used by AI-assisted features.
AI_INTEGRATIONS_ANTHROPIC_API_KEY=replace-with-your-provider-key
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

NODE_ENV=development
